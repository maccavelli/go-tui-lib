  8|.SH NAME
 35|app-workspace-resize - Move a split
  0|
  0|
 12|.SH SYNOPSIS
 42|\fBapp workspace resize SPLIT N [flags]\fP
  0|
  0|
 15|.SH DESCRIPTION
 47|Moves a named split's separator by delta cells.
  0|
  0|
 11|.SH OPTIONS
 13|\fB--args\fP=
 32|	the arguments as one JSON object
  0|
  3|.PP
 20|\fB--json\fP[=false]
 32|	print the result's value as JSON
  0|
  3|.PP
 19|\fB--yes\fP[=false]
 40|	run a destructive command without asking
  0|
  3|.PP
 14|\fB--split\fP=
 42|	the split whose separator moves (required)
  0|
  3|.PP
 14|\fB--delta\fP=
 72|	cells to give the pane before it; negative takes (required; -200 to 200)
  0|
  3|.PP
 31|\fB-q\fP, \fB--quiet\fP[=false]
  8|	say less
  0|
  3|.PP
 30|\fB-h\fP, \fB--help\fP[=false]
