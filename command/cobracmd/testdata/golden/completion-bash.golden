 32|__app_format_comp_descriptions()
  1|{
 19|    local tab=$'\t'
 33|    local comp desc maxdesclength
 20|    local longest=$1
  0|
 14|    local i ci
 34|    for ci in ${!COMPREPLY[*]}; do
 29|        comp=${COMPREPLY[ci]}
 94|        # Properly format the description string which follows a tab character if there is one
 40|        if [[ "$comp" == *$tab* ]]; then
 46|            __app_debug "Original comp: $comp"
 30|            desc=${comp#*$tab}
 31|            comp=${comp%%$tab*}
  0|
 54|            # $COLUMNS stores the current shell width.
 74|            # Remove an extra 4 because we add 2 spaces and 2 parentheses.
 54|            maxdesclength=$(( COLUMNS - longest - 4 ))
  0|
 73|            # Make sure we can fit a description of at least 8 characters
 50|            # if we are to align the descriptions.
 42|            if ((maxdesclength > 8)); then
 75|                # Add the proper number of spaces to align the descriptions
 60|                for ((i = ${#comp} ; i < longest ; i++)); do
 29|                    comp+=" "
 20|                done
 16|            else
 89|                # Don't pad the descriptions so we can fit more text after the completion
 59|                maxdesclength=$(( COLUMNS - ${#comp} - 4 ))
 14|            fi
  0|
 64|            # If there is enough space for any description text,
 77|            # truncate the descriptions that are too long for the shell width
 42|            if ((maxdesclength > 0)); then
 53|                if ((${#desc} > maxdesclength)); then
 59|                    desc=${desc:0:$(( maxdesclength - 1 ))}
 29|                    desc+="…"
 18|                fi
 33|                comp+="  ($desc)"
 14|            fi
