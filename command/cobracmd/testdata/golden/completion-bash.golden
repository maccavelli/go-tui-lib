 41|__app_handle_standard_completion_case() {
 19|    local tab=$'\t'
  0|
 63|    # If there are no completions, we don't need to do anything
 45|    (( ${#completions[@]} == 0 )) && return 0
  0|
 61|    # Short circuit to optimize if we don't have descriptions
 48|    if [[ "${completions[*]}" != *$tab* ]]; then
 68|        # First, escape the completions to handle special characters
 83|        IFS=$'\n' read -ra completions -d '' < <(printf "%q\n" "${completions[@]}")
 70|        # Only consider the completions that match what the user typed
101|        IFS=$'\n' read -ra COMPREPLY -d '' < <(IFS=$'\n'; compgen -W "${completions[*]}" -- "${cur}")
  0|
 90|        # compgen looses the escaping so, if there is only a single completion, we need to
 97|        # escape it again because it will be inserted on the command-line.  If there are multiple
 90|        # completions, we don't want to escape them because they will be printed in a list
