 79|# fish completion for app                                  -*- shell-script -*-
  0|
 20|function __app_debug
 39|    set -l file "$BASH_COMP_DEBUG_FILE"
 22|    if test -n "$file"
 29|        echo "$argv" >> $file
  7|    end
  3|end
  0|
 33|function __app_perform_completion
 51|    __app_debug "Starting __app_perform_completion"
  0|
 42|    # Extract all args except the last one
 34|    set -l args (commandline -opc)
 62|    # Extract the last arg and escape it in case it is a space
 55|    set -l lastArg (string escape -- (commandline -ct))
  0|
 29|    __app_debug "args: $args"
 36|    __app_debug "last arg: $lastArg"
  0|
 62|    # Disable ActiveHelp which is not supported for fish shell
 84|    set -l requestComp "APP_ACTIVE_HELP=0 $args[1] __complete $args[2..-1] $lastArg"
  0|
 38|    __app_debug "Calling $requestComp"
 51|    set -l results (eval $requestComp 2> /dev/null)
  0|
 69|    # Some programs may output extra empty lines after the directive.
 57|    # Let's ignore them or else it will break completion.
 53|    # Ref: https://github.com/spf13/cobra/issues/1279
 31|    for line in $results[-1..1]
 43|        if test (string trim -- $line) = ""
 44|            # Found an empty line, remove it
 39|            set results $results[1..-2]
 12|        else
 61|            # Found non-empty line, we have our proper output
 17|            break
 11|        end
  7|    end
  0|
 32|    set -l comps $results[1..-2]
 37|    set -l directiveLine $results[-1]
  0|
 75|    # For Fish, when completing a flag with an = (e.g., <program> -n=<TAB>)
 48|    # completions must be prefixed with the flag
 60|    set -l flagPrefix (string match -r -- '-.*=' "$lastArg")
  0|
 31|    __app_debug "Comps: $comps"
 47|    __app_debug "DirectiveLine: $directiveLine"
 41|    __app_debug "flagPrefix: $flagPrefix"
  0|
 22|    for comp in $comps
 45|        printf "%s%s\n" "$flagPrefix" "$comp"
  7|    end
  0|
 34|    printf "%s\n" "$directiveLine"
  3|end
  0|
124|# this function limits calls to __app_perform_completion, by caching the result behind $__app_perform_completion_once_result
 38|function __app_perform_completion_once
 56|    __app_debug "Starting __app_perform_completion_once"
  0|
 54|    if test -n "$__app_perform_completion_once_result"
 97|        __app_debug "Seems like a valid result already exists, skipping __app_perform_completion"
 16|        return 0
  7|    end
  0|
 80|    set --global __app_perform_completion_once_result (__app_perform_completion)
 54|    if test -z "$__app_perform_completion_once_result"
 63|        __app_debug "No completions, probably due to a failure"
 16|        return 1
  7|    end
  0|
 84|    __app_debug "Performed completions and set __app_perform_completion_once_result"
 12|    return 0
  3|end
  0|
109|# this function is used to clear the $__app_perform_completion_once_result variable after completions are run
 51|function __app_clear_perform_completion_once_result
 18|    __app_debug ""
108|    __app_debug "========= clearing previously set __app_perform_completion_once_result variable =========="
 52|    set --erase __app_perform_completion_once_result
 87|    __app_debug "Successfully erased the variable __app_perform_completion_once_result"
  3|end
  0|
 42|function __app_requires_order_preservation
 18|    __app_debug ""
 81|    __app_debug "========= checking if order preservation is required =========="
  0|
 33|    __app_perform_completion_once
 54|    if test -z "$__app_perform_completion_once_result"
 73|        __app_debug "Error determining if order preservation is required"
 16|        return 1
  7|    end
  0|
 85|    set -l directive (string sub --start 2 $__app_perform_completion_once_result[-1])
 42|    __app_debug "Directive is: $directive"
  0|
 41|    set -l shellCompDirectiveKeepOrder 32
 90|    set -l keeporder (math (math --scale 0 $directive / $shellCompDirectiveKeepOrder) % 2)
 42|    __app_debug "Keeporder is: $keeporder"
  0|
 28|    if test $keeporder -ne 0
 58|        __app_debug "This does require order preservation"
 16|        return 0
  7|    end
  0|
 57|    __app_debug "This doesn't require order preservation"
 12|    return 1
  3|end
  0|
  0|
 32|# This function does two things:
 74|# - Obtain the completions and store them in the global __app_comp_results
 55|# - Return false if file completion should be performed
 34|function __app_prepare_completions
 18|    __app_debug ""
 64|    __app_debug "========= starting completion logic =========="
  0|
 17|    # Start fresh
 34|    set --erase __app_comp_results
  0|
 33|    __app_perform_completion_once
 75|    __app_debug "Completion results: $__app_perform_completion_once_result"
  0|
 54|    if test -z "$__app_perform_completion_once_result"
 62|        __app_debug "No completion, probably due to a failure"
 60|        # Might as well do file completion, in case it helps
 16|        return 1
  7|    end
  0|
 85|    set -l directive (string sub --start 2 $__app_perform_completion_once_result[-1])
 80|    set --global __app_comp_results $__app_perform_completion_once_result[1..-2]
  0|
 54|    __app_debug "Completions are: $__app_comp_results"
 42|    __app_debug "Directive is: $directive"
  0|
 36|    set -l shellCompDirectiveError 1
 38|    set -l shellCompDirectiveNoSpace 2
 41|    set -l shellCompDirectiveNoFileComp 4
 44|    set -l shellCompDirectiveFilterFileExt 8
 42|    set -l shellCompDirectiveFilterDirs 16
  0|
 27|    if test -z "$directive"
 23|        set directive 0
  7|    end
  0|
 84|    set -l compErr (math (math --scale 0 $directive / $shellCompDirectiveError) % 2)
 26|    if test $compErr -eq 1
 57|        __app_debug "Received error directive: aborting."
 60|        # Might as well do file completion, in case it helps
 16|        return 1
  7|    end
  0|
 95|    set -l filefilter (math (math --scale 0 $directive / $shellCompDirectiveFilterFileExt) % 2)
 91|    set -l dirfilter (math (math --scale 0 $directive / $shellCompDirectiveFilterDirs) % 2)
 55|    if test $filefilter -eq 1; or test $dirfilter -eq 1
 83|        __app_debug "File extension filtering or directory filtering not supported"
 41|        # Do full file completion instead
 16|        return 1
  7|    end
  0|
 86|    set -l nospace (math (math --scale 0 $directive / $shellCompDirectiveNoSpace) % 2)
 89|    set -l nofiles (math (math --scale 0 $directive / $shellCompDirectiveNoFileComp) % 2)
  0|
 54|    __app_debug "nospace: $nospace, nofiles: $nofiles"
  0|
 75|    # If we want to prevent a space, or if file completion is NOT disabled,
 55|    # we need to count the number of valid completions.
 76|    # To do so, we will filter on prefix as the completions we have received
 75|    # may not already be filtered so as to allow fish to match on different
 31|    # criteria than the prefix.
 50|    if test $nospace -ne 0; or test $nofiles -eq 0
 68|        set -l prefix (commandline -t | string escape --style=regex)
 37|        __app_debug "prefix: $prefix"
  0|
 80|        set -l completions (string match -r -- "^$prefix.*" $__app_comp_results)
 52|        set --global __app_comp_results $completions
 67|        __app_debug "Filtered completions are: $__app_comp_results"
  0|
 63|        # Important not to quote the variable for count to work
 51|        set -l numComps (count $__app_comp_results)
 41|        __app_debug "numComps: $numComps"
  0|
 56|        if test $numComps -eq 1; and test $nospace -ne 0
 76|            # We must first split on \t to get rid of the descriptions to be
 63|            # able to check what the actual completion will be.
 76|            # We don't need descriptions anyway since there is only a single
 70|            # real completion which the shell will expand immediately.
 73|            set -l split (string split --max 1 \t $__app_comp_results[1])
  0|
 68|            # Fish won't add a space if the completion ends with any
 49|            # of the following characters: @=/:.,
 56|            set -l lastChar (string sub -s -1 -- $split)
 63|            if not string match -r -q "[@=/:.,]" -- "$lastChar"
 87|                # In other cases, to support the "nospace" directive we trick the shell
 60|                # by outputting an extra, longer completion.
 83|                __app_debug "Adding second completion to perform nospace directive"
 68|                set --global __app_comp_results $split[1] $split[1].
 70|                __app_debug "Completions are now: $__app_comp_results"
 15|            end
 11|        end
  0|
 56|        if test $numComps -eq 0; and test $nofiles -eq 0
 70|            # To be consistent with bash and zsh, we only trigger file
 60|            # completion when there are no other completions
 52|            __app_debug "Requesting file completion"
 20|            return 1
 11|        end
  7|    end
  0|
 12|    return 0
  3|end
  0|
 95|# Since Fish completions are only loaded once the user triggers them, we trigger them ourselves
 71|# so we can properly delete any completions provided by another script.
 88|# Only do this if the program can be found, or else fish may print some errors; besides,
 75|# the existing completions will only be loaded if the program can be found.
 16|if type -q "app"
 89|    # The space after the program name is essential to trigger completion for the program
 52|    # and not completion of the program name itself.
 92|    # Also, we use '> /dev/null 2>&1' since '&>' is not supported in older versions of fish.
 50|    complete --do-complete "app " > /dev/null 2>&1
  3|end
  0|
 92|# Remove any pre-existing completions for the program since we will be handling all of them.
 18|complete -c app -e
  0|
107|# this will get called after the two calls below and clear the $__app_perform_completion_once_result global
 63|complete -c app -n '__app_clear_perform_completion_once_result'
 69|# The call to __app_prepare_completions will setup __app_comp_results
 50|# which provides the program's completion choices.
 70|# If this doesn't require order preservation, we don't use the -k flag
115|complete -c app -n 'not __app_requires_order_preservation && __app_prepare_completions' -f -a '$__app_comp_results'
 30|# otherwise we use the -k flag
114|complete -k -c app -n '__app_requires_order_preservation && __app_prepare_completions' -f -a '$__app_comp_results'
