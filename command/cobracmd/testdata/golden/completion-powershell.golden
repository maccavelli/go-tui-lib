 53|                        $comp.Name = $comp.Name + " "
 21|                    }
  0|
 84|                    # Check for empty description and only add parentheses if needed
 56|                    if ($($comp.Description) -eq " " ) {
 41|                        $Description = ""
 28|                    } else {
 65|                        $Description = "  ($($comp.Description))"
 21|                    }
  0|
 65|                    $CompletionText = "$($comp.Name)$Description"
