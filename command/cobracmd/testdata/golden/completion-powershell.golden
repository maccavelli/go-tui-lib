 30|    $Values | ForEach-Object {
  0|
 58|        # store temporary because switch will overwrite $_
 18|        $comp = $_
  0|
 62|        # PowerShell supports three different completion modes
100|        # - TabCompleteNext (default windows style - on each key press the next option is displayed)
 38|        # - Complete (works like bash)
 41|        # - MenuComplete (works like zsh)
 82|        # You set the mode with Set-PSReadLineKeyHandler -Key Tab -Function <mode>
  0|
 37|        # CompletionResult Arguments:
 73|        # 1) CompletionText text to be used as the auto completion result
 71|        # 2) ListItemText   text to be displayed in the suggestion list
 53|        # 3) ResultType     type of completion result
 78|        # 4) ToolTip        text for the tooltip with details about the object
  0|
 24|        switch ($Mode) {
  0|
 23|            # bash like
 24|            "Complete" {
  0|
 43|                if ($Values.Length -eq 1) {
 58|                    __app_debug "Only one completion left"
  0|
 46|                    # insert space after value
 97|                    $CompletionText = $($comp.Name | __app_escapeStringWithSpecialChars) + $Space
 88|                    if ($ExecutionContext.SessionState.LanguageMode -eq "FullLanguage"){
152|                        [System.Management.Automation.CompletionResult]::new($CompletionText, "$($comp.Name)", 'ParameterValue', "$($comp.Description)")
 28|                    } else {
 39|                        $CompletionText
 21|                    }
  0|
 24|                } else {
 79|                    # Add the proper number of spaces to align the descriptions
