 12|#compdef app
 16|compdef _app app
  0|
 78|# zsh completion for app                                  -*- shell-script -*-
  0|
 13|__app_debug()
  1|{
 38|    local file="$BASH_COMP_DEBUG_FILE"
 29|    if [[ -n ${file} ]]; then
 30|        echo "$*" >> "${file}"
  6|    fi
  1|}
  0|
  6|_app()
  1|{
 35|    local shellCompDirectiveError=1
 37|    local shellCompDirectiveNoSpace=2
 40|    local shellCompDirectiveNoFileComp=4
 43|    local shellCompDirectiveFilterFileExt=8
 41|    local shellCompDirectiveFilterDirs=16
 40|    local shellCompDirectiveKeepOrder=32
  0|
 97|    local lastParam lastChar flagPrefix requestComp out directive comp lastComp noSpace keepOrder
 24|    local -a completions
  0|
 66|    __app_debug "\n========= starting completion logic =========="
 60|    __app_debug "CURRENT: ${CURRENT}, words[*]: ${words[*]}"
  0|
 73|    # The user could have moved the cursor backwards on the command-line.
 74|    # We need to trigger completion from the $CURRENT location, so we need
 72|    # to truncate the command-line ($words) up to the $CURRENT location.
 84|    # (We cannot use $CURSOR as its value does not work when a command is an alias.)
 34|    words=("${=words[1,CURRENT]}")
 50|    __app_debug "Truncated words[*]: ${words[*]},"
  0|
 26|    lastParam=${words[-1]}
 29|    lastChar=${lastParam[-1]}
 64|    __app_debug "lastParam: ${lastParam}, lastChar: ${lastChar}"
  0|
 68|    # For zsh, when completing a flag with an = (e.g., app -n=<TAB>)
 48|    # completions must be prefixed with the flag
 37|    setopt local_options BASH_REMATCH
 43|    if [[ "${lastParam}" =~ '-.*=' ]]; then
 46|        # We are dealing with a flag with an =
 39|        flagPrefix="-P ${BASH_REMATCH}"
  6|    fi
  0|
 47|    # Prepare the command to obtain completions
 55|    requestComp="${words[1]} __complete ${words[2,-1]}"
 35|    if [ "${lastChar}" = "" ]; then
 75|        # If the last parameter is complete (there is a space following it)
 92|        # We add an extra empty parameter so we can indicate this to the go completion code.
 50|        __app_debug "Adding extra empty parameter"
 41|        requestComp="${requestComp} \"\""
  6|    fi
  0|
 52|    __app_debug "About to call: eval ${requestComp}"
  0|
 59|    # Use eval to handle any environment variables and such
 42|    out=$(eval ${requestComp} 2>/dev/null)
 43|    __app_debug "completion output: ${out}"
  0|
 68|    # Extract the directive integer following a : from the last line
 18|    local lastLine
 35|    while IFS='\n' read -r line; do
 24|        lastLine=${line}
 39|    done < <(printf "%s\n" "${out[@]}")
 40|    __app_debug "last line: ${lastLine}"
  0|
 37|    if [ "${lastLine[1]}" = : ]; then
 35|        directive=${lastLine[2,-1]}
 62|        # Remove the directive including the : and the newline
 20|        local suffix
 34|        (( suffix=${#lastLine}+2))
 30|        out=${out[1,-$suffix]}
  8|    else
 61|        # There is no directive specified.  Leave $out as is.
 61|        __app_debug "No directive found.  Setting do default"
 19|        directive=0
  6|    fi
  0|
 41|    __app_debug "directive: ${directive}"
 37|    __app_debug "completions: ${out}"
 43|    __app_debug "flagPrefix: ${flagPrefix}"
  0|
 63|    if [ $((directive & shellCompDirectiveError)) -ne 0 ]; then
 70|        __app_debug "Completion received error. Ignoring completions."
 14|        return
  6|    fi
  0|
 42|    local activeHelpMarker="_activeHelp_ "
 39|    local endIndex=${#activeHelpMarker}
 48|    local startIndex=$((${#activeHelpMarker}+1))
 25|    local hasActiveHelp=0
 35|    while IFS='\n' read -r comp; do
 90|        # Check if this is an activeHelp statement (i.e., prefixed with $activeHelpMarker)
 64|        if [ "${comp[1,$endIndex]}" = "$activeHelpMarker" ];then
 49|            __app_debug "ActiveHelp found: $comp"
 42|            comp="${comp[$startIndex,-1]}"
 35|            if [ -n "$comp" ]; then
 36|                compadd -x "${comp}"
 60|                __app_debug "ActiveHelp will need delimiter"
 31|                hasActiveHelp=1
 14|            fi
  0|
 20|            continue
 10|        fi
  0|
 31|        if [ -n "$comp" ]; then
 72|            # If requested, completions are returned with a description.
 61|            # The description is preceded by a TAB character.
 71|            # For zsh's _describe, we need to use a : instead of a TAB.
 77|            # We first need to escape any : as part of the completion itself.
 31|            comp=${comp//:/\\:}
  0|
 38|            local tab="$(printf '\t')"
 32|            comp=${comp//$tab/:}
  0|
 52|            __app_debug "Adding completion: ${comp}"
 32|            completions+=${comp}
 26|            lastComp=$comp
 10|        fi
 39|    done < <(printf "%s\n" "${out[@]}")
  0|
 67|    # Add a delimiter after the activeHelp statements, but only if:
 69|    # - there are completions following the activeHelp statements, or
 89|    # - file completion will be performed (so there will be choices after the activeHelp)
 37|    if [ $hasActiveHelp -eq 1 ]; then
101|        if [ ${#completions} -ne 0 ] || [ $((directive & shellCompDirectiveNoFileComp)) -eq 0 ]; then
 53|            __app_debug "Adding activeHelp delimiter"
 27|            compadd -x "--"
 27|            hasActiveHelp=0
 10|        fi
  6|    fi
  0|
 65|    if [ $((directive & shellCompDirectiveNoSpace)) -ne 0 ]; then
 41|        __app_debug "Activating nospace."
 23|        noSpace="-S ''"
  6|    fi
  0|
 67|    if [ $((directive & shellCompDirectiveKeepOrder)) -ne 0 ]; then
 44|        __app_debug "Activating keep order."
 22|        keepOrder="-V"
  6|    fi
  0|
 71|    if [ $((directive & shellCompDirectiveFilterFileExt)) -ne 0 ]; then
 34|        # File extension filtering
 26|        local filteringCmd
 29|        filteringCmd='_files'
 43|        for filter in ${completions[@]}; do
 44|            if [ ${filter[1]} != '*' ]; then
 66|                # zsh requires a glob pattern to do file filtering
 35|                filter="\*.$filter"
 14|            fi
 39|            filteringCmd+=" -g $filter"
 12|        done
 38|        filteringCmd+=" ${flagPrefix}"
  0|
 59|        __app_debug "File filtering command: $filteringCmd"
 47|        _arguments '*:filename:'"$filteringCmd"
 70|    elif [ $((directive & shellCompDirectiveFilterDirs)) -ne 0 ]; then
 46|        # File completion for directories only
 20|        local subdir
 34|        subdir="${completions[1]}"
 33|        if [ -n "$subdir" ]; then
 56|            __app_debug "Listing directories in $subdir"
 45|            pushd "${subdir}" >/dev/null 2>&1
 12|        else
 50|            __app_debug "Listing directories in ."
 10|        fi
  0|
 20|        local result
 56|        _arguments '*:dirname:_files -/'" ${flagPrefix}"
 17|        result=$?
 33|        if [ -n "$subdir" ]; then
 32|            popd >/dev/null 2>&1
 10|        fi
 22|        return $result
  8|    else
 39|        __app_debug "Calling _describe"
 89|        if eval _describe $keepOrder "completions" completions $flagPrefix $noSpace; then
 58|            __app_debug "_describe found some completions"
  0|
 59|            # Return the success of having called _describe
 20|            return 0
 12|        else
 61|            __app_debug "_describe did not find completions."
 67|            __app_debug "Checking if we should do file completion."
 76|            if [ $((directive & shellCompDirectiveNoFileComp)) -ne 0 ]; then
 58|                __app_debug "deactivating file completion"
  0|
 86|                # We must return an error code here to let zsh know that there were no
 81|                # completions found by _describe; this is what will trigger other
 69|                # matching algorithms to attempt to find completions.
 75|                # For example zsh can match letters in the middle of words.
 24|                return 1
 16|            else
 41|                # Perform file completion
 56|                __app_debug "Activating file completion"
  0|
 78|                # We must return the result of this command, so it must be the
 78|                # last command, or else we must store its result to return it.
 62|                _arguments '*:filename:_files'" ${flagPrefix}"
 14|            fi
 10|        fi
  6|    fi
  1|}
  0|
 67|# don't run the completion function when being source-ed or eval-ed
 37|if [ "$funcstack[1]" = "_app" ]; then
  8|    _app
  2|fi
