 25|# bash completion for app
 17|_app_complete() {
 50|    local cur="${COMP_WORDS[COMP_CWORD]}" line out
 94|    out=$("${COMP_WORDS[0]}" __complete "${COMP_WORDS[@]:1:COMP_CWORD}" 2>/dev/null) || return
 16|    COMPREPLY=()
 31|    while IFS= read -r line; do
 30|        line="${line%%$'\t'*}"
 66|        [[ -n $line && $line == "$cur"* ]] && COMPREPLY+=("$line")
 18|    done <<<"$out"
  1|}
 40|complete -o default -F _app_complete app
